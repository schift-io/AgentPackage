{
  "version": "apm.runtime.binding.v1",
  "bindings": {
    "apm://runtime/task-turn-probe@0.1.0": {
      "provider": "supabase-edge",
      "resource": "projects/projectref0123456789/functions/apm-task-turn",
      "invoke_url": "https://projectref0123456789.functions.supabase.co",
      "auth": {
        "type": "http-header-secret",
        "credential_ref": "env:APM_TASK_TURN_PROBE_SECRET",
        "parameters": {
          "application_secret_header": "x-apm-task-turn-probe-secret",
          "invoke_path_prefix": "/apm-task-turn"
        }
      },
      "capabilities": [
        "human_input_channel"
      ]
    }
  }
}
