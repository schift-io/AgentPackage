{
  "version": "apm.runtime.binding.v1",
  "bindings": {
    "apm://runtime/task-turn-probe@0.1.0": {
      "provider": "cloudflare-worker",
      "resource": "accounts/0123456789abcdef0123456789abcdef/workers/services/apm-task-turn",
      "invoke_url": "https://apm-task-turn.example.workers.dev",
      "auth": {
        "type": "http-header-secret",
        "credential_ref": "env:APM_TASK_TURN_PROBE_SECRET",
        "parameters": {
          "application_secret_header": "x-apm-task-turn-probe-secret"
        }
      },
      "capabilities": [
        "human_input_channel"
      ]
    }
  }
}
